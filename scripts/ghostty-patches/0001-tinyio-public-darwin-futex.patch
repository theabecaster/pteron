+    ) c_int;
+    extern "c" fn os_sync_wake_by_address_any(addr: *anyopaque, size: usize, flags: u32) c_int;
+    extern "c" fn os_sync_wake_by_address_all(addr: *anyopaque, size: usize, flags: u32) c_int;
+};
